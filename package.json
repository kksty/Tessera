{
  "name": "tessera",
  "version": "0.3.0",
  "private": true,
  "description": "Tessera — 探索成图，证据成链。模型驱动的自主安全测试工作台。",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "export:work-prompts": "tsx scripts/export-prompts.ts",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:traffic": "python -m unittest discover -s tests/traffic -p test_*.py",
    "test:browser": "node scripts/checks/browser.cjs",
    "test:frontend-browser": "tsx scripts/checks/frontend-browser.ts",
    "test:completion-browser": "tsx scripts/checks/completion-browser.ts",
    "test:deletion-config-browser": "tsx scripts/checks/deletion-config-browser.ts",
    "test:models-browser": "tsx scripts/checks/models-browser.ts",
    "test:memory-real-model": "tsx scripts/checks/memory-model.ts",
    "test:decide-real-model": "tsx scripts/checks/decide-model.ts",
    "test:model-observation": "tsx scripts/checks/model-observation.ts",
    "observe:projects": "tsx scripts/checks/project-observation.ts",
    "test:m6": "node --test tests/m6/pilot.test.mjs",
    "m6": "tsx scripts/m6/run.mjs",
    "m6:resume": "tsx scripts/m6/resume.mjs",
    "test:usage-browser": "tsx scripts/checks/usage-browser.ts",
    "test:tools-browser": "tsx scripts/checks/tools-browser.ts",
    "test:settings-browser": "tsx scripts/checks/settings-browser.ts",
    "test:result-format-probe": "tsx scripts/checks/result-format.ts",
    "test:docker": "node scripts/checks/docker.cjs",
    "dev": "tsx apps/server/src/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "start": "node dist/server.mjs",
    "dispatch": "node dist/dispatcher.mjs",
    "lint": "eslint apps packages scripts tests --max-warnings=0",
    "format:check": "node scripts/format.mjs",
    "format": "node scripts/format.mjs --write",
    "test:coverage": "node scripts/test.mjs --experimental-test-coverage --test-coverage-lines=80 --test-coverage-branches=70 --test-coverage-functions=80 --test-coverage-include=packages/**/*.ts --test-coverage-include=apps/server/**/*.ts --test-coverage-include=apps/dispatcher/**/*.ts --test-coverage-exclude=**/main.ts",
    "test:storage-load": "tsx scripts/checks/storage-load.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@fastify/static": "^8.3.0",
    "@sinclair/typebox": "^0.34.41",
    "cytoscape": "^3.33.1",
    "cytoscape-dagre": "^2.5.0",
    "cytoscape-elk": "^2.3.0",
    "cytoscape-klay": "^3.1.4",
    "dockerode": "^4.0.9",
    "fastify": "^5.6.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cytoscape-dagre": "^2.3.3",
    "@types/dockerode": "^3.3.44",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.11",
    "eslint": "^10.13.0",
    "playwright": "^1.58.2",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
