# Configuration precedence: explicit non-empty env > persisted runtime.json > application defaults.
# - Do not show env-source labels in the UI; env-managed fields must reject edits in both UI and API.
# - Document variables here. Recreate services after changing their environment.
# - Never persist env overrides, especially API keys, when saving runtime.json.
# Empty/whitespace-only optional values are unset; numeric 0 is explicit and is validated normally.
# Invalid explicit values fail startup. Non-empty values lock their corresponding UI/API fields.
# Removing an override restores the persisted/default value after service recreation.
# Full policy: docs/project.md. Comments use ASCII for Windows editors.

# /data is always a Docker named volume (default tessera-data); host-directory
# mounts are not supported. Set TESSERA_DATA_VOLUME only to attach a different
# existing volume; `docker compose down` never deletes it. Create it once with
# `docker volume create`.
TESSERA_DATA_VOLUME=tessera-data

# Host-side address: 127.0.0.1 for local-only; 0.0.0.0 to allow LAN connections.
TESSERA_BIND_ADDRESS=127.0.0.1

# Host-side port; the container listens on port 8000.
TESSERA_PORT=8000

# Images are built locally from this checkout (server and runtime share one tag).
# TESSERA_IMAGE_TAG names the local images; default latest. Set another tag before
# rebuilding to keep a rollback copy, for example 0.3.0.
TESSERA_IMAGE_TAG=latest
# Advanced: complete image references override the local build names.
# Leave both blank to build from source; set both only for images you built and
# pushed to your own registry.
TESSERA_APP_IMAGE=
TESSERA_WORKER_IMAGE=
# Worker build target: runtime is the default, full adds optional tools.
TESSERA_WORKER_TARGET=runtime
TESSERA_NETWORK=tessera-network
TESSERA_VOLUME_PREFIX=
# Internal worker-to-server URL (default http://tessera-server:8000).
TESSERA_INTERNAL_URL=

# Optional scheduling overrides. Blank leaves the field editable in web settings.
# Defaults: max_workers=4; max_project_workers=4; max_project_review_workers=1 (clamped to project concurrency).
TESSERA_MAX_WORKERS=
TESSERA_MAX_PROJECT_WORKERS=
TESSERA_MAX_PROJECT_REVIEW_WORKERS=
# Defaults: scheduler interval=1000 ms; Decide change batching window=2000 ms.
TESSERA_INTERVAL_MS=
TESSERA_DEBOUNCE_MS=
# Default: task_timeout_seconds=0 (unlimited); closeout_seconds=60.
# A positive task timeout must be at least 30; closeout_seconds must then be shorter.
TESSERA_TASK_TIMEOUT_SECONDS=
TESSERA_CLOSEOUT_SECONDS=
# Defaults: tool_timeout_seconds=0 (no platform cap; model timeout optional); result_repairs=2 (0 disables result repair).
TESSERA_TOOL_TIMEOUT_SECONDS=
TESSERA_RESULT_REPAIRS=
# Force the informational-review exemption from the deployment (true/false).
# Unset keeps whatever the settings page stores; set false so it cannot be re-enabled.
TESSERA_SKIP_INFORMATIONAL_REVIEW=
# Planning budget. A single Decide round may create at most this many new Steps
# (0 = unlimited; default 2) and a project may hold at most this many open Steps
# (0 = unlimited; default 8). Near-duplicate merges and in-place updates do not
# count. A plan that exceeds either cap is rejected and writes nothing.
TESSERA_MAX_NEW_STEPS_PER_ROUND=
TESSERA_MAX_OPEN_STEPS=
# Control-plane timeout budget (defaults in packages/protocol/src/timeouts.ts):
# lease=180s, commit=30s, usage=30s, diagnostics=15s, model=600s.
# The lease is the server-side value; the settings page wins over this variable.
TESSERA_LEASE_SECONDS=
TESSERA_COMMIT_TIMEOUT_MS=
TESSERA_USAGE_TIMEOUT_MS=
TESSERA_DIAGNOSTICS_TIMEOUT_MS=
TESSERA_MODEL_TIMEOUT_MS=

# Capture proxy upstream TLS ceiling: TLS1_2 (default), TLS1_3, or UNBOUNDED.
# TLS1_2 keeps legacy targets that abort TLS 1.3 handshakes working on the first request.
TESSERA_CAPTURE_TLS_MAX=

# Model configuration can also be saved from the web settings page.
# PI_MODEL -> model.id; PI_BASE_URL -> model.base_url; PI_API_KEY -> model.api_key.
# PI_PROVIDER selects a Pi provider (deepseek, zai, zai-coding-cn, minimax, minimax-cn, etc.).
# Built-in providers can leave PI_BASE_URL empty; Pi supplies its native endpoint and protocol.
# PI_PROVIDER_API -> model.api; PI_CONTEXT_WINDOW -> model.context_window.
# Window/output defaults: 0 (automatic Pi metadata; unknown endpoints: 128000 / 16384).
# Positive window/output values cap the deployment. Blank env allows persisted/web configuration.
PI_MODEL=
PI_PROVIDER=
PI_BASE_URL=
PI_API_KEY=
PI_PROVIDER_API=
PI_CONTEXT_WINDOW=
PI_MAX_OUTPUT_TOKENS=

# Optional independent review model. Leave all blank to use persisted review settings or the main model.
# When any review override is set, provide a review model ID and either a Pi provider or URL.
# Missing review fields use their own defaults, never an implicit copy of the main model's API key.
PI_REVIEW_MODEL=
PI_REVIEW_PROVIDER=
PI_REVIEW_BASE_URL=
PI_REVIEW_API_KEY=
PI_REVIEW_PROVIDER_API=
PI_REVIEW_CONTEXT_WINDOW=
PI_REVIEW_MAX_OUTPUT_TOKENS=

# Optional override. Empty uses a generated persistent credential shared by server/dispatcher.
# Internal APIs always require this credential; empty does not disable authentication.
TESSERA_WORKER_TOKEN=
# Set to 1 when the web UI is served over HTTPS (also auto-detected from
# X-Forwarded-Proto). Plain-HTTP local installs should leave this blank.
TESSERA_COOKIE_SECURE=

# Web login is single-account. Leave both values empty to generate credentials on first startup.
# Generated credentials are printed once in: docker compose logs tessera-server
TESSERA_OPERATOR_USER=
TESSERA_OPERATOR_PASSWORD=

# Lossless hot/cold storage retention, in days. 0 keeps that category hot.
# Archival preserves APIs/history and compresses old bodies into SQLite; it is not deletion.
TESSERA_EVENT_HOT_DAYS=90
TESSERA_DIAGNOSTIC_HOT_DAYS=30
TESSERA_EVIDENCE_HOT_DAYS=30
TESSERA_ARCHIVE_BATCH=1000
TESSERA_LOG_LEVEL=info

# Image builds (root Dockerfile; targets: server, runtime, full).
# Uncomment for mainland-China mirrors.
# DEBIAN_MIRROR=https://mirrors.ustc.edu.cn
# KALI_MIRROR=http://mirrors.ustc.edu.cn/kali
# COREPACK_NPM_REGISTRY=https://registry.npmmirror.com
# Optional Playwright CLI version baked into the worker image.
# PLAYWRIGHT_CLI_VERSION=0.1.22
# Optional GitHub-release prefix when github.com is unreachable from Docker.
# The pinned SHA-256 is still verified after download.
# CHAINREACTORS_PROXY=https://ghproxy.net
# Optional PyPI index for the dirsearch compatibility wheel.
# PIP_INDEX_URL=https://mirrors.ustc.edu.cn/pypi/web/simple
